# GarageST local E2E database configuration — TEMPLATE.
# Copy this file to `garagest-e2e.env` (already gitignored) and fill in real
# values locally. Never commit garagest-e2e.env, and never paste its real
# contents into chat, a commit message, or a report.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=garageos
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password

GOOGLE_DRIVE_APPLICATION_NAME=GarageST

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_DRIVE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_client_secret

# Must match the redirect URI registered on that OAuth client exactly.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/api/v1/media/google/callback

# The Drive folder (by its Drive file ID) the backend roots all
# garage/job-card/stage subfolders under.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id
